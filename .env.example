USER_AGENT=Holdover/0.1 (you@example.com)
TZ=America/Los_Angeles
# HOME_LAT=
# HOME_LON=
# ENABLED_ZONES=willamette,central,northwest   # ODFW zones to fetch and offer; each adds a few stocking pages a day (see app/zones)
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_EXTRACT_MODEL=   # optional: a slower, stronger model just for the weekly report extraction (runs once a week); default = LLM_MODEL
# LLM_EXTRACT_TIMEOUT=1800
# LLM_TIMEOUT=180   # seconds per request; raise it for a reasoning model (they think for minutes on a long report)
# LLM_MODEL=   # exactly as the server lists it (GET /v1/models), with no provider prefix: gemma4-e4b, not openai/gemma4-e4b
# HOLDOVER_PORT=8000
# COOKIE_SECURE=true   # force the Secure flag; unset = automatic (HTTPS or X-Forwarded-Proto)
# SESSION_DAYS=90
# INVITE_DAYS=7
# TRUSTED_PROXY_HOPS=1   # number of reverse proxies in front (they must append to X-Forwarded-For)
# USGS_API=ogc   # ogc = the Water Data API (default); legacy = waterservices.usgs.gov, retired by USGS in early 2027
