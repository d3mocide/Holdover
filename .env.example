USER_AGENT=Holdover/0.1 (you@example.com)
TZ=America/Los_Angeles
# HOME_LAT=
# HOME_LON=
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=   # exactly as the server lists it (GET /v1/models), with no provider prefix: gemma4-e4b, not openai/gemma4-e4b
# HOLDOVER_PORT=8000
# COOKIE_SECURE=true   # force the Secure flag; unset = automatic (HTTPS or X-Forwarded-Proto)
# SESSION_DAYS=90
# INVITE_DAYS=7
# TRUSTED_PROXY_HOPS=1   # number of reverse proxies in front (they must append to X-Forwarded-For)
# USGS_API=ogc   # ogc = the Water Data API (default); legacy = waterservices.usgs.gov, retired by USGS in early 2027
