# Development image for the API: dependencies only. The source is bind-mounted and uvicorn reloads on change.
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 DATA_DIR=/data DATABASE_URL=sqlite:////data/holdover.db TZ=America/Los_Angeles
WORKDIR /app
COPY pyproject.toml ./
RUN mkdir app && touch app/__init__.py && pip install -e ".[dev,postgres]"
EXPOSE 8000
CMD ["sh", "-c", "python -m app.cli migrate && python -m app.cli seed && exec uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload"]
